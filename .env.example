# Copy this file to .env and fill in the secrets. Never commit .env.

NODE_ENV=development
PORT=3000

# The database from docker-compose.yml (npm run db:up).
# connection_limit: the largest number of connections in the pool.
DATABASE_URL=postgresql://docuchat:docuchat@localhost:5442/docuchat?connection_limit=10

# Two different secrets, each at least 32 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Optional: "npm run db:seed" makes an admin user from these two values.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Not necessary before the later weeks:
# OPENAI_API_KEY=
# REDIS_URL=redis://localhost:6379
